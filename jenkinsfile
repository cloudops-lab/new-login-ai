pipeline {
    agent {
        label 'dev'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'master',
                    credentialsId: 'git_creds',
                    url: 'https://github.com/cloudops-lab/loginapp.git'
            }
        }

        stage('Build & Test') {
            steps {
                sh '''#!/bin/bash
                    set -o pipefail
                    mvn clean install package 2>&1 | tee pipeline.log
                '''
            }
            post {
                failure {
                    sh '''#!/bin/bash
                        export LLM_API_KEY="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"
                        if [ -f pipeline.log ]; then
                            echo "=== TRIGGERING AI AGENT FOR TRIAGE ==="
                            python3 script/ai_agent_remediate.py pipeline.log || true
                        fi
                    '''
                }
            }
        }
    }
    post {
        always {
            cleanWs(deleteDirs: true, notFailBuild: true)
        }
    }
}
