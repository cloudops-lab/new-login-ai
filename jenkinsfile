pipeline {
    agent {
        label 'dev'
    }

    environment {
        LLM_API_KEY = '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'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'master',
                    credentialsId: 'git_creds',
                    url: 'https://github.com/cloudops-lab/new-login-ai.git'
            }
        }

        stage('Build & AI Auto-Healing PR') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'git_creds', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_PASS')]) {
                    sh '''#!/bin/bash
                        set -o pipefail

                        AUTH_REPO="https://${GIT_USER}:${GIT_PASS}@github.com/cloudops-lab/loginapp.git"
                        BRANCH_NAME="ai-fix-${BUILD_NUMBER}"

                        git config user.name "Chandandhani"
                        git config user.email "ai-agent@cloudops.internal"

                        # 1. Attempt the build
                        if mvn clean install package 2>&1 | tee pipeline.log; then
                            echo "=== BUILD SUCCEEDED ==="
                        else
                            echo "=== BUILD FAILED: INITIATING AI AGENT AUTO-HEAL ==="

                            # 2. Run AI agent to patch pom.xml
                            python3 script/ai_agent_remediate.py pipeline.log

                            # 3. Create unique branch and push to GitHub
                            git checkout -b "${BRANCH_NAME}"
                            git add pom.xml
                            git commit -m "fix(ci): autonomous patch by AI agent for build #${BUILD_NUMBER}"
                            git push "${AUTH_REPO}" "${BRANCH_NAME}" --force
                            echo "=== PUSHED ${BRANCH_NAME} TO GITHUB ==="

                            # 4. Generate PR payload safely via Python to avoid shell escape issues
                            python3 -c "
import json
payload = {
    'title': 'fix(ci): Auto-healing patch for Build #${BUILD_NUMBER}',
    'head': '${BRANCH_NAME}',
    'base': 'master',
    'body': '### AI Agent CI/CD Remediation Report\\n\\n- **Cause:** Maven compiler JDK compatibility error (Java 6 unsupported).\\n- **Remediation:** Upgraded project jdk.version to 1.8 in pom.xml.\\n\\nPlease review and merge this PR.'
}
with open('pr_payload.json', 'w') as f:
    json.dump(payload, f)
"

                            # 5. Create Pull Request on GitHub
                            PR_RESPONSE=$(curl -s -X POST \
                              -H "Authorization: token ${GIT_PASS}" \
                              -H "Accept: application/vnd.github.v3+json" \
                              https://Chandandhani@github.com/cloudops-lab/new-login-ai/pulls \
                              -d @pr_payload.json)

                            PR_URL=$(echo "${PR_RESPONSE}" | grep -o '"html_url": *"[^"]*"' | head -n 1 | cut -d '"' -f 4)

                            echo "======================================================="
                            echo " PULL REQUEST CREATED: ${PR_URL}"
                            echo " Please visit GitHub and approve the PR to apply changes."
                            echo "======================================================="

                            exit 1
                        fi
                    '''
                }
            }
        }
    }

    post {
        always {
            cleanWs(deleteDirs: true, notFailBuild: true)
        }
    }
}
